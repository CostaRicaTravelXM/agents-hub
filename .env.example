# ---- App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (local values come from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Share the session with the Agent Portal: ".travelxm.com" in production, empty locally
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Show the "Continue with Google" button (configure the provider in Supabase first)
NEXT_PUBLIC_GOOGLE_AUTH=false

# ---- Media storage: Cloudflare R2 in production, RustFS locally
# Production: R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, R2_FORCE_PATH_STYLE=false
R2_ENDPOINT=http://localhost:9000
R2_REGION=auto
R2_ACCESS_KEY_ID=academy
R2_SECRET_ACCESS_KEY=academy-dev-secret
R2_FORCE_PATH_STYLE=true
R2_PRIVATE_BUCKET=academy-private
R2_PUBLIC_BUCKET=academy-public
# Public base URL of the public bucket (R2 custom domain, e.g. https://media.travelxm.com)
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/academy-public
# Comma-separated origins allowed to upload from the browser
STORAGE_CORS_ORIGINS=http://localhost:3000

# ---- Password reset
# Signs the 15-minute "opened the reset email" cookie. Any long random string
# (openssl rand -base64 32). Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
AUTH_RECOVERY_SECRET=

# ---- Email (Supabase Auth SMTP), set up before launch.
# Locally, Mailpit at http://127.0.0.1:54324 captures every email instead.
# Used by [auth.email.smtp] in supabase/config.toml once it is uncommented.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
