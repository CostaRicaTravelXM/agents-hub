# ---- App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (local values come from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Share the session with the Agent Portal: ".travelxm.com" in production, empty locally
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Show the "Continue with Google" button (configure the provider in Supabase first)
NEXT_PUBLIC_GOOGLE_AUTH=false
# The Agents Portal (quotes, bookings, verification). Leave empty to hide its entry in the Hub.
NEXT_PUBLIC_AGENTS_PORTAL_URL=http://localhost:3001

# ---- Marketing Assets
# Google API key restricted to the Drive API. Server only: never prefix it with NEXT_PUBLIC_.
# Leave empty and the page links out to Google Drive instead of showing the files.
GOOGLE_DRIVE_API_KEY=

# ---- CRM
# n8n "TravelXM — Agents Hub" webhook. After an account is created the Hub sends
# name, email, agency and partner type once, so the lead exists in Zoho CRM.
# Leave empty to skip the hand-off (local development).
N8N_AGENTS_WEBHOOK_URL=

# Zoho CRM API, called by the Hub itself (docs/THANKSGIVING.md has the steps).
# With these three set, sign-up leads and Thanksgiving gift claims are written
# straight to Zoho and the n8n webhook above is no longer used. Leave empty and
# nothing is sent: sign-ups fall back to n8n, gift claims wait in the database.
# Use a dedicated Self Client with only these scopes (never .ALL):
#   ZohoCRM.modules.leads.READ,ZohoCRM.modules.leads.CREATE,ZohoCRM.modules.leads.UPDATE,
#   ZohoCRM.modules.contacts.READ,ZohoCRM.modules.contacts.UPDATE,ZohoSearch.securesearch.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data centre. US: accounts.zoho.com / www.zohoapis.com. EU: .eu, India: .in, Australia: .com.au
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com

# ---- Thanksgiving gift page (/thanksgiving)
# Cloudflare Turnstile keys. Leave empty to skip the bot check (local development).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Media storage: Cloudflare R2 in production, RustFS locally
# Production: R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, R2_FORCE_PATH_STYLE=false
R2_ENDPOINT=http://localhost:9000
R2_REGION=auto
R2_ACCESS_KEY_ID=academy
R2_SECRET_ACCESS_KEY=academy-dev-secret
R2_FORCE_PATH_STYLE=true
R2_PRIVATE_BUCKET=academy-private
R2_PUBLIC_BUCKET=academy-public
# Public base URL of the public bucket (R2 custom domain, e.g. https://media.travelxm.com)
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/academy-public
# Comma-separated origins allowed to upload from the browser
STORAGE_CORS_ORIGINS=http://localhost:3000

# ---- Password reset
# Signs the 15-minute "opened the reset email" cookie. Any long random string
# (openssl rand -base64 32). Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
AUTH_RECOVERY_SECRET=

# ---- Email (Supabase Auth SMTP), set up before launch.
# Locally, Mailpit at http://127.0.0.1:54324 captures every email instead.
# Used by [auth.email.smtp] in supabase/config.toml once it is uncommented.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
